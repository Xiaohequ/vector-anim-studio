{
  "version": 3,
  "name": "Démo vasf-3 Groupe 3",
  "canvas": {"width": 720, "height": 1280, "fps": 25, "background": "#14161C"},
  "theme": {
    "ciel_nuit": "#1B2A4A",
    "ciel_couchant": "#7A3B2E",
    "flamme": "#FF5C5C",
    "braise": "#F2C94C",
    "bois": "#8B5E3C",
    "chair": "#FFE3C2"
  },
  "shapes": [
    {
      "name": "Ciel",
      "type": "rect",
      "color": "$ciel_nuit",
      "width": 720, "height": 1280,
      "x": 360, "y": 640,
      "end": 4,
      "keyframes": [
        {"t": 0, "color": "$ciel_nuit"},
        {"t": 2, "easing": "linear", "color": "$ciel_couchant"},
        {"t": 4, "easing": "linear", "color": "$ciel_nuit"}
      ]
    },
    {
      "name": "Flamme",
      "layers": [
        {
          "name": "Langue",
          "type": "path",
          "color": "$flamme",
          "points": [[620, 780], [700, 780], [660, 640]]
        },
        {
          "name": "Cœur",
          "type": "circle",
          "color": "$braise",
          "width": 70, "height": 70,
          "x": 660, "y": 730
        }
      ],
      "end": 4,
      "cycle": {"repeat": 3},
      "keyframes": [
        {
          "t": 0,
          "colors": {"Langue": "$flamme"},
          "layerPoints": {"Langue": [[620, 780], [700, 780], [660, 640]]}
        },
        {
          "t": 0.6,
          "easing": "easeOut",
          "colors": {"Langue": "$braise"},
          "layerPoints": {"Langue": [[610, 780], [710, 780], [690, 570]]}
        },
        {
          "t": 1.2,
          "easing": "linear",
          "colors": {"Langue": "$flamme"},
          "layerPoints": {"Langue": [[620, 780], [700, 780], [660, 640]]}
        }
      ]
    },
    {
      "name": "Bâton",
      "type": "rect",
      "color": "$bois",
      "width": 260, "height": 22,
      "x": 640, "y": 760,
      "rotation": -20,
      "end": 4
    },
    {
      "name": "Main",
      "type": "circle",
      "color": "$chair",
      "width": 64, "height": 64,
      "x": 620, "y": 775,
      "end": 4
    },
    {
      "name": "Avant-bras",
      "type": "rect",
      "color": "$chair",
      "width": 74, "height": 64,
      "x": 590, "y": 792,
      "rotation": -30,
      "end": 4
    },
    {
      "name": "Bras",
      "type": "rect",
      "color": "$chair",
      "width": 90, "height": 80,
      "x": 560, "y": 855,
      "end": 4
    }
  ],
  "skeleton": {
    "name": "Bras qui remue le feu",
    "bones": [
      {"name": "Épaule", "joint": [560, 900], "angle": -90, "length": 90, "ik": true, "bend": 1},
      {"name": "Coude", "parent": "Épaule", "joint": [560, 810], "angle": -30, "length": 70},
      {"name": "Poignet", "parent": "Coude", "joint": [620, 775], "angle": -60, "length": 55}
    ],
    "bind": {
      "Bras": "Épaule",
      "Avant-bras": "Coude",
      "Main": "Poignet",
      "Bâton": "Poignet"
    },
    "keyframes": [
      {"bone": "Épaule", "t": 0, "angle": -90},
      {"bone": "Épaule", "t": 1, "angle": -78, "move": [0, -12], "easing": "easeInOut"},
      {"bone": "Épaule", "t": 2, "angle": -90, "easing": "easeInOut"},
      {"bone": "Épaule", "t": 3, "angle": -78, "move": [0, -12], "easing": "easeInOut"},
      {"bone": "Épaule", "t": 4, "angle": -90, "move": [0, 0], "easing": "easeInOut"},
      {"bone": "Coude", "t": 0, "angle": -30},
      {"bone": "Coude", "t": 1, "angle": -18, "easing": "easeInOut"},
      {"bone": "Coude", "t": 2, "angle": -30, "easing": "easeInOut"},
      {"bone": "Coude", "t": 3, "angle": -18, "easing": "easeInOut"},
      {"bone": "Coude", "t": 4, "angle": -30, "easing": "easeInOut"},
      {"bone": "Poignet", "t": 0, "angle": -60},
      {"bone": "Poignet", "t": 1, "angle": -45, "easing": "easeInOut"},
      {"bone": "Poignet", "t": 2, "angle": -60, "easing": "easeInOut"},
      {"bone": "Poignet", "t": 3, "angle": -45, "easing": "easeInOut"},
      {"bone": "Poignet", "t": 4, "angle": -60, "easing": "easeInOut"}
    ]
  }
}
