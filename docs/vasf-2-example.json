{
  "version": 2,
  "name": "Bonhomme qui hoche la tête",
  "canvas": {
    "width": 720,
    "height": 1280,
    "fps": 25,
    "background": "#14161C"
  },
  "theme": {
    "peau": "#FFE3C2",
    "encre": "#14161C",
    "veste": "#5B8DEF"
  },
  "defs": {
    "main": {
      "type": "circle",
      "color": "$peau",
      "width": 56,
      "height": 56
    }
  },
  "shapes": [
    {
      "name": "Corps",
      "type": "rect",
      "color": "$veste",
      "width": 150,
      "height": 220,
      "x": 360,
      "y": 980,
      "end": 2
    },
    {
      "name": "Tête",
      "x": 360,
      "y": 800,
      "end": 2,
      "layers": [
        {
          "name": "Peau",
          "type": "circle",
          "color": "$peau",
          "width": 170,
          "height": 170
        },
        {
          "name": "Œil gauche",
          "type": "circle",
          "color": "$encre",
          "width": 26,
          "height": 26,
          "x": -34,
          "y": -22
        },
        {
          "name": "Œil droit",
          "type": "circle",
          "color": "$encre",
          "width": 26,
          "height": 26,
          "x": 34,
          "y": -22
        },
        {
          "name": "Sourire",
          "type": "path",
          "filled": false,
          "strokeWidth": 5,
          "points": [
            [
              -38,
              28
            ],
            [
              38,
              28
            ],
            [
              0,
              58
            ]
          ],
          "y": 43
        }
      ],
      "keyframes": [
        {
          "t": 0.0,
          "y": 800,
          "easing": "easeInOut"
        },
        {
          "t": 0.5,
          "y": 780,
          "easing": "easeInOut"
        },
        {
          "t": 1.0,
          "y": 800,
          "easing": "easeInOut"
        }
      ],
      "cycle": {
        "repeat": 1
      }
    },
    {
      "name": "Main gauche",
      "ref": "main",
      "x": 240,
      "y": 900,
      "end": 2
    },
    {
      "name": "Main droite",
      "ref": "main",
      "x": 480,
      "y": 900,
      "end": 2
    }
  ]
}